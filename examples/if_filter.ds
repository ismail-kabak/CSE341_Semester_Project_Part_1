-- Program 3: if/then/else + function call + boolean expression in WHERE
table employees = load "employees.csv"

function active_above(t: table, threshold: int) -> table {
    return SELECT name, salary, department
           FROM t
           WHERE salary > threshold AND NOT active == false
           ORDER BY salary DESC
}

let cutoff = 50000

if cutoff > 0 then {
    let result = active_above(employees, cutoff)
    print result
} else {
    print employees
}
