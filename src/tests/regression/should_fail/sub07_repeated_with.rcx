// Cat 3: repeated with: keyword — must fail
recipe smoothie(servings: int) serves servings {
    ingredient milk     : 150 ml * servings
    ingredient oat_milk : 150 ml * servings
    step "blend" { blend() }
}
evaluate substitute(smoothie(servings: 2), milk, with: oat_milk, with: oat_milk, ratio: 1.0)
