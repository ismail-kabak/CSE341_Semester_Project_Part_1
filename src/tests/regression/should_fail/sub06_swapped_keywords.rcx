// Cat 3: ratio: before with: (swapped keyword order) — must fail
recipe smoothie(servings: int) serves servings {
    ingredient milk     : 150 ml * servings
    ingredient oat_milk : 150 ml * servings
    step "blend" { blend() }
}
evaluate substitute(smoothie(servings: 2), milk, ratio: 1.0, with: oat_milk)
